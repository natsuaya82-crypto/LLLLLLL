<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- The Lingua keyboard: the Android half of ios/App/LinguaKeyboard/:
             an input method inside this app that reads what LinguaShare.write
             put in the app's own storage (keyboard/Shared.kt). Named "Lingua",
             which is never translated. BIND_INPUT_METHOD means only the
             system may bind it. -->
        <service
            android:name=".keyboard.LinguaIme"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <!-- A notification that arrives while the app is in front
             (LinguaPushService.kt). Firebase finds it by this action; it does
             nothing until android/app/google-services.json is in. The channel
             is the one push-send names (`CHANNEL`, push.mjs). -->
        <service
            android:name=".LinguaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="lingua" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The voice on a post (www/rec.js). The page opens the microphone with
         getUserMedia, and Capacitor's web view asks Android for the
         permission only if it is declared here; undeclared, it refuses
         without asking. MODIFY_AUDIO_SETTINGS is what the web view's audio
         capture needs beside it. NSMicrophoneUsageDescription is the same
         line on iOS. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Notifications (LinguaPushPlugin.kt). Android 13 and later ask the
         person; UNdeclared, the question is never put and the answer is no.
         iOS asks through requestAuthorization with nothing declared. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
