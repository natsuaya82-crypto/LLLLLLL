#!/bin/sh
# Refuse a commit that would ship a blank screen or an untranslated one.
#
# Install once:  git config core.hooksPath tools
# Skip once:     git commit --no-verify
#
# Only runs when the app itself changed, so commits that touch the README or
# the workflow files stay instant.
#
# The font writer used to live twice — once in tools/font-spike/otf5.js and
# once copied into www/index.html — and this hook's first job was catching a
# commit that changed one and not the other. It lives once now, at
# www/otf5.js, and that whole class of mistake is gone with it.

if git diff --cached --name-only | grep -q '^www/'; then
  echo 'assets: checking index.html points at files that are in the commit...'
  node tools/assets-check.mjs >/dev/null || {
    echo ''
    node tools/assets-check.mjs
    echo ''
    echo 'index.html would ship pointing at files this commit does not carry.'
    echo 'That is a white screen for everyone but you. `git add` them, or fix'
    echo 'the script tags.'
    exit 1
  }
fi

if git diff --cached --name-only | grep -q '^www/'; then
  echo 'es5: the app has to run in an old WKWebView...'
  node tools/es5-check.mjs >/dev/null || {
    echo ''
    node tools/es5-check.mjs
    echo ''
    echo 'Modern syntax under www/ is a blank screen on a real iPhone, and'
    echo 'nothing on this machine would ever show it to you. Rewrite it in ES5.'
    exit 1
  }
fi

# The three that need no browser, so they cost about a second and a half between
# them. sides-check is here rather than only in `npm test` because what it
# catches -- the making side reaching into the timeline -- is invisible while
# every post is yours, which is to say invisible to whoever is committing.
if git diff --cached --name-only | grep -q '^www/'; then
  echo 'dead + import + sides + face + box: the fast five...'
  node tools/dead-check.mjs >/dev/null && node tools/import-check.mjs >/dev/null \
    && node tools/sides-check.mjs >/dev/null && node tools/face-check.mjs >/dev/null \
    && node tools/box-check.mjs >/dev/null || {
    echo ''
    node tools/dead-check.mjs >/dev/null || node tools/dead-check.mjs
    node tools/import-check.mjs >/dev/null || node tools/import-check.mjs
    node tools/sides-check.mjs >/dev/null || node tools/sides-check.mjs
    node tools/face-check.mjs >/dev/null || node tools/face-check.mjs
    node tools/box-check.mjs >/dev/null || node tools/box-check.mjs
    exit 1
  }
fi

# The screen files are the ones that can carry untranslated text; the ten
# language files and the font writer cannot, so a commit that only touches
# those does not need the two-minute walk.
#
# This named the seven files it thought were screens, and two of them --
# screens.js and sentences.js -- have not existed since that list was written,
# while the screens themselves moved into home.js, words.js, letters.js, post.js
# and a dozen others. So a commit that added a hard-coded string to any of those
# skipped the walk, quietly, which is the one thing this hook is for. It asks
# the other way round now: everything under www/ except the files that cannot
# carry a string.
if git diff --cached --name-only | grep -E '^www/' | grep -qvE '^www/(i18n/[a-z]{2}\.js|otf5\.js)$'; then
  echo 'i18n: checking every screen in every language...'
  node tools/i18n-check.mjs || {
    echo ''
    echo 'i18n check failed. Fix the above, or commit with --no-verify if you'
    echo 'are deliberately landing this half-done.'
    exit 1
  }
fi
