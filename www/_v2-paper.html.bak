<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#f6f3ec">
<title>Lingua</title>
<style>
  :root{
    --paper:#f6f3ec; --card:#fffdf8; --ink:#191817; --sub:#6c6862; --faint:#9b968d;
    --line:rgba(25,24,23,.13); --line2:rgba(25,24,23,.07);
    --red:#b4402c;           /* 赤ペン ＝ AIの注記 */
    --redbg:rgba(180,64,44,.06);
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{
    background:var(--paper); color:var(--ink); line-height:1.75;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Noto Sans JP","Yu Gothic",sans-serif;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  #app{max-width:480px;margin:0 auto;min-height:100dvh;padding-bottom:96px}

  /* ---------- header ---------- */
  .hd{padding:calc(env(safe-area-inset-top,0) + 14px) 20px 0;display:flex;align-items:center;gap:10px}
  .logo{font-family:"Iowan Old Style",Georgia,serif;font-size:.92rem;letter-spacing:.14em;color:var(--sub)}
  .lang{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:.86rem;color:var(--ink);
        border:1px solid var(--line);border-radius:999px;padding:4px 12px;background:var(--card);cursor:pointer}
  .lang .pen{color:var(--faint);font-size:.7rem}

  .h1{font-size:1.32rem;font-weight:700;letter-spacing:.01em;line-height:1.5;padding:18px 20px 2px}
  .sub{padding:0 20px;color:var(--sub);font-size:.83rem;line-height:1.7}

  .sec{padding:26px 20px 0}
  .sech{display:flex;align-items:baseline;gap:8px;margin-bottom:10px}
  .sech b{font-size:.94rem;font-weight:700}
  .sech .c{font-size:.7rem;color:var(--faint);margin-left:auto}

  /* ---------- 赤ペン注記＝AIが見つけたこと ---------- */
  .find{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 15px;margin-bottom:9px}
  .find .tag{display:inline-block;font-size:.6rem;letter-spacing:.09em;color:var(--red);
             border:1px solid rgba(180,64,44,.35);background:var(--redbg);border-radius:5px;padding:1px 6px;margin-bottom:6px}
  .find .ft{font-size:.97rem;font-weight:600;line-height:1.6}
  .find .ft em{font-family:"Iowan Old Style",Georgia,serif;font-style:normal;color:var(--red);font-weight:700}
  .find .fd{font-size:.76rem;color:var(--sub);margin-top:3px}
  .find .bar{height:3px;border-radius:2px;background:var(--line2);margin-top:9px;overflow:hidden}
  .find .bar i{display:block;height:100%;background:var(--red);opacity:.55}

  .empty{border:1px dashed var(--line);border-radius:12px;padding:18px 16px;color:var(--sub);font-size:.83rem;text-align:center}

  /* ---------- buttons ---------- */
  .btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:15px;border-radius:11px;
       border:none;background:var(--ink);color:#fff;font-family:inherit;font-size:.97rem;font-weight:700;cursor:pointer}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
  .btn.red{background:var(--red)}
  .btn:active{opacity:.75}
  .btn2{display:flex;gap:9px;margin-top:12px}
  .btn2 .btn{flex:1;font-size:.9rem;padding:13px}

  /* ---------- きこえ方 ---------- */
  .say{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
  .say .w{font-family:"Iowan Old Style",Georgia,serif;font-size:1.5rem;letter-spacing:.01em}
  .say .k{color:var(--sub);font-size:.9rem;margin-top:2px;letter-spacing:.08em}
  .say .jp{font-size:.83rem;color:var(--faint);margin-top:6px}
  .say .lk{margin-top:11px;padding-top:11px;border-top:1px dashed var(--line)}
  .say .lk .lb{font-size:.62rem;letter-spacing:.08em;color:var(--red);margin-bottom:2px}
  .say .lk .kk{font-size:1rem;letter-spacing:.1em}
  .sp{margin-top:12px;width:100%;padding:11px;border-radius:9px;border:1px solid var(--line);background:transparent;
      font-family:inherit;font-size:.85rem;font-weight:600;color:var(--ink);cursor:pointer}

  /* ---------- 数値 ---------- */
  .stats{display:flex;gap:9px;padding:22px 20px 0}
  .stat{flex:1;background:var(--card);border:1px solid var(--line);border-radius:11px;padding:12px 4px;text-align:center}
  .stat b{display:block;font-family:"Iowan Old Style",Georgia,serif;font-size:1.4rem;line-height:1.2}
  .stat span{font-size:.62rem;color:var(--faint);letter-spacing:.04em}

  /* ---------- 辞書 ---------- */
  .search{margin:12px 20px 0;display:flex;align-items:center;gap:9px;background:var(--card);
          border:1px solid var(--line);border-radius:10px;padding:10px 13px}
  .search input{flex:1;background:none;border:none;color:var(--ink);font-family:inherit;font-size:.9rem;outline:none}
  .lex{padding:6px 20px 0}
  .gl{font-family:"Iowan Old Style",Georgia,serif;font-size:.85rem;color:var(--red);margin:18px 0 2px;letter-spacing:.1em}
  .en{padding:12px 2px;border-bottom:1px solid var(--line2);display:flex;align-items:baseline;gap:9px;cursor:pointer}
  .en:active{opacity:.6}
  .en .hw{font-family:"Iowan Old Style",Georgia,serif;font-size:1.16rem}
  .en .kn{font-size:.68rem;color:var(--faint);letter-spacing:.06em}
  .en .mn{margin-left:auto;font-size:.87rem;color:var(--sub);text-align:right}
  .en .ps{font-size:.58rem;color:var(--faint);border:1px solid var(--line);border-radius:4px;padding:0 5px}

  /* ---------- つくる ---------- */
  .chips{display:flex;flex-wrap:wrap;gap:7px}
  .chip{font-size:.8rem;padding:7px 13px;border-radius:999px;border:1px solid var(--line);background:var(--card);cursor:pointer}
  .chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
  .cand{display:flex;align-items:center;gap:10px;padding:11px 2px;border-bottom:1px solid var(--line2)}
  .cand .ck{width:19px;height:19px;border-radius:5px;border:1.5px solid var(--line);flex-shrink:0;
            display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#fff;cursor:pointer}
  .cand.on .ck{background:var(--ink);border-color:var(--ink)}
  .cand .cw{font-family:"Iowan Old Style",Georgia,serif;font-size:1.08rem;cursor:pointer}
  .cand .cn{font-size:.63rem;color:var(--faint)}
  .cand .cm{margin-left:auto;font-size:.83rem;color:var(--sub)}
  .cand .re{font-size:.6rem;color:var(--red);border:1px solid rgba(180,64,44,.3);border-radius:4px;padding:1px 5px;cursor:pointer;flex-shrink:0}
  .bar-fix{position:fixed;left:0;right:0;bottom:0;max-width:480px;margin:0 auto;z-index:30;
           background:linear-gradient(180deg,rgba(246,243,236,0),var(--paper) 26%);padding:20px 20px calc(env(safe-area-inset-bottom,0) + 62px)}

  /* ---------- 音 ---------- */
  .inv{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
  .ph{font-family:"Iowan Old Style",Georgia,serif;font-size:.95rem;background:var(--card);border:1px solid var(--line);
      border-radius:7px;padding:5px 11px;cursor:pointer}
  .ph.off{opacity:.3;text-decoration:line-through;cursor:default}
  .ph i{font-style:normal;font-size:.6rem;color:var(--faint);margin-left:4px}

  /* ---------- tabbar ---------- */
  .tabs{position:fixed;left:0;right:0;bottom:0;max-width:480px;margin:0 auto;z-index:40;display:flex;
        background:rgba(246,243,236,.94);backdrop-filter:blur(12px);border-top:1px solid var(--line);
        padding-bottom:env(safe-area-inset-bottom,0)}
  .tab{flex:1;padding:9px 0 10px;text-align:center;font-size:.66rem;color:var(--faint);cursor:pointer;letter-spacing:.04em}
  .tab b{display:block;font-size:.98rem;font-weight:600;color:var(--faint);line-height:1.5;font-family:"Iowan Old Style",Georgia,serif}
  .tab.on,.tab.on b{color:var(--ink)}

  /* ---------- sheet ---------- */
  .sbg{position:fixed;inset:0;z-index:50;background:rgba(25,24,23,.35);opacity:0;pointer-events:none;transition:.22s}
  .sbg.on{opacity:1;pointer-events:auto}
  .sheet{position:fixed;left:0;right:0;bottom:0;z-index:51;max-width:480px;margin:0 auto;background:var(--paper);
         border-radius:18px 18px 0 0;padding:8px 20px calc(env(safe-area-inset-bottom,0) + 20px);
         transform:translateY(101%);transition:.26s cubic-bezier(.2,.8,.2,1);max-height:92dvh;overflow:auto}
  .sheet.on{transform:none}
  .grip{width:36px;height:4px;border-radius:3px;background:rgba(25,24,23,.18);margin:6px auto 14px}
  .sheet h3{font-size:1.03rem;margin:0 0 4px;font-weight:700}
  .sheet .lead{font-size:.78rem;color:var(--sub);margin-bottom:14px}
  .fld{margin-bottom:11px}
  .fld label{font-size:.66rem;color:var(--faint);letter-spacing:.04em;display:block;margin-bottom:5px}
  .fld input,.fld select{width:100%;background:var(--card);border:1px solid var(--line);border-radius:9px;color:var(--ink);
                         padding:12px 12px;font-family:inherit;font-size:.95rem;outline:none}
  .fld input.lt{font-family:"Iowan Old Style",Georgia,serif;font-size:1.1rem}
  .row2{display:flex;gap:9px}.row2 .fld{flex:1}
  .pv{background:var(--redbg);border:1px solid rgba(180,64,44,.25);border-radius:9px;padding:10px 12px;margin-bottom:12px}
  .pv .pl{font-size:.6rem;color:var(--red);letter-spacing:.07em}
  .pv .pk{font-size:.95rem;letter-spacing:.08em;margin-top:1px}
  .sug{display:flex;flex-wrap:wrap;gap:7px;margin:2px 0 13px}
  .sug .s{font-family:"Iowan Old Style",Georgia,serif;font-size:1rem;border:1px solid rgba(180,64,44,.3);
          background:var(--redbg);color:var(--ink);border-radius:8px;padding:6px 12px;cursor:pointer}
  .sug .s.on{background:var(--red);color:#fff;border-color:var(--red)}

  .toast{position:fixed;left:50%;bottom:96px;transform:translate(-50%,14px);background:var(--ink);color:#fff;
         font-size:.82rem;padding:10px 18px;border-radius:999px;z-index:80;opacity:0;transition:.22s;pointer-events:none}
  .toast.on{opacity:1;transform:translate(-50%,0)}
  .fade{animation:f .22s ease both}@keyframes f{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
</style>
</head>
<body>
<div id="app"></div>
<div class="tabs" id="tabs"></div>
<div class="sbg" id="sbg" onclick="closeS()"><div class="sheet" id="sheet" onclick="event.stopPropagation()"></div></div>
<div class="toast" id="toast"></div>

<script>
/* =========================================================================
   Lingua — つくった言語からAIが規則を見つけ、発音と語彙づくりを肩代わりする
   ========================================================================= */

/* ---------- state ---------- */
let langName = 'Elyrra語';
let WORDS = [
  {hw:'Aelin', mn:'星',    pos:'名詞'},
  {hw:'Elora', mn:'光',    pos:'名詞'},
  {hw:'Lsuna', mn:'月',    pos:'名詞'},
  {hw:'Mirae', mn:'愛する', pos:'動詞'},
  {hw:'Naeth', mn:'水',    pos:'名詞'},
  {hw:'Silva', mn:'森',    pos:'名詞'},
  {hw:'Vaera', mn:'空',    pos:'名詞'},
  {hw:'Ythe',  mn:'風',    pos:'名詞'}
];
const LS_W='lingua.words', LS_N='lingua.lang';
try{var _w=JSON.parse(localStorage.getItem(LS_W)); if(Array.isArray(_w)&&_w.length) WORDS=_w;}catch(e){}
try{var _n=localStorage.getItem(LS_N); if(_n) langName=_n;}catch(e){}
function save(){try{localStorage.setItem(LS_W,JSON.stringify(WORDS));localStorage.setItem(LS_N,langName);}catch(e){}}

/* =========================================================================
   1. 音韻コア — つづりから音節と音の在庫を割り出す
   ========================================================================= */
var VOW='aeiouy';
function isV(c){return VOW.indexOf(c)>=0;}

function syl(word){
  var s=String(word).toLowerCase().replace(/[^a-z]/g,''), out=[], i=0;
  while(i<s.length){
    var c=''; while(i<s.length && !isV(s[i])){c+=s[i];i++;}
    var v=''; while(i<s.length &&  isV(s[i])){v+=s[i];i++;}
    if(v===''){ if(out.length) out[out.length-1]+=c; else if(c) out.push(c); }
    else out.push(c+v);
  }
  return out;
}
var PART=/^([^aeiouy]*)([aeiouy]+)([^aeiouy]*)$/;
function parts(sy){ var m=sy.match(PART); return m?{on:m[1],nu:m[2],co:m[3]}:null; }

var CONS=['b','ch','d','f','g','h','j','k','l','m','n','p','r','s','sh','t','th','v','w','z'];
function splitC(str){
  var out=[], i=0;
  while(i<str.length){
    var two=str.substr(i,2);
    if(two==='th'||two==='sh'||two==='ch'){out.push(two);i+=2;}
    else {out.push(str[i]);i++;}
  }
  return out;
}

/* 辞書全体を読んで「この言語の規則」を推定する */
function analyze(){
  var on={},onI={},onM={},nu={},co={},cnt={},fin={},posN={};
  WORDS.forEach(function(w){
    var ss=syl(w.hw);
    cnt[ss.length]=(cnt[ss.length]||0)+1;
    ss.forEach(function(s,si){
      var p=parts(s); if(!p) return;
      on[p.on]=(on[p.on]||0)+1; nu[p.nu]=(nu[p.nu]||0)+1;
      /* 語頭に立てる子音と、語中にしか出ない子音は別物（音素配列の規則） */
      if(si===0) onI[p.on]=(onI[p.on]||0)+1; else onM[p.on]=(onM[p.on]||0)+1;
      if(p.co) co[p.co]=(co[p.co]||0)+1;
    });
    var f=String(w.hw).toLowerCase().slice(-1);
    fin[w.pos]=fin[w.pos]||{}; fin[w.pos][f]=(fin[w.pos][f]||0)+1;
    posN[w.pos]=(posN[w.pos]||0)+1;
  });
  var finalRule={};
  Object.keys(fin).forEach(function(p){
    if(posN[p]<3) return;
    var e=Object.keys(fin[p]).map(function(k){return [k,fin[p][k]];}).sort(function(a,b){return b[1]-a[1];})[0];
    if(e && e[1]/posN[p]>=0.5) finalRule[p]={ch:e[0],hit:e[1],all:posN[p],rate:e[1]/posN[p]};
  });
  var used={};
  Object.keys(on).forEach(function(o){ if(o) splitC(o).forEach(function(c){used[c]=1;}); });
  Object.keys(co).forEach(function(o){ splitC(o).forEach(function(c){used[c]=1;}); });
  var usedA=Object.keys(used).sort();
  var unused=CONS.filter(function(c){return !used[c];});
  var sm=Object.keys(cnt).map(function(k){return [k,cnt[k]];}).sort(function(a,b){return b[1]-a[1];})[0];
  var vset={}; Object.keys(nu).forEach(function(n){ n.split('').forEach(function(v){vset[v]=1;}); });
  return {on:on,onI:onI,onM:onM,nu:nu,co:co,cnt:cnt,finalRule:finalRule,used:usedA,unused:unused,
          sylMode: sm?{n:+sm[0],hit:sm[1],all:WORDS.length}:null,
          vowels:Object.keys(vset).sort()};
}

/* =========================================================================
   2. 発音 — つづりから読みを機械的に導く
   ========================================================================= */
var KT={
  '' :['ア','イ','ウ','エ','オ'],
  k:['カ','キ','ク','ケ','コ'], g:['ガ','ギ','グ','ゲ','ゴ'],
  s:['サ','スィ','ス','セ','ソ'], z:['ザ','ズィ','ズ','ゼ','ゾ'],
  t:['タ','ティ','トゥ','テ','ト'], d:['ダ','ディ','ドゥ','デ','ド'],
  n:['ナ','ニ','ヌ','ネ','ノ'], h:['ハ','ヒ','フ','ヘ','ホ'],
  b:['バ','ビ','ブ','ベ','ボ'], p:['パ','ピ','プ','ペ','ポ'],
  m:['マ','ミ','ム','メ','モ'], y:['ヤ','イ','ユ','イェ','ヨ'],
  r:['ラ','リ','ル','レ','ロ'], l:['ラ','リ','ル','レ','ロ'],
  w:['ワ','ウィ','ウ','ウェ','ウォ'], v:['ヴァ','ヴィ','ヴ','ヴェ','ヴォ'],
  f:['ファ','フィ','フ','フェ','フォ'], j:['ジャ','ジ','ジュ','ジェ','ジョ'],
  sh:['シャ','シ','シュ','シェ','ショ'], ch:['チャ','チ','チュ','チェ','チョ'],
  th:['サ','シ','ス','セ','ソ']
};
var VI={a:0,i:1,u:2,e:3,o:4,y:1};
var VK=['ア','イ','ウ','エ','オ'];
var CODA={n:'ン',m:'ム',s:'ス',th:'ス',sh:'シュ',t:'ト',d:'ド',k:'ク',g:'グ',l:'ル',r:'ル',
          p:'プ',b:'ブ',v:'ヴ',f:'フ',z:'ズ',ch:'チ',j:'ジ',h:'フ',w:'ウ',y:'イ'};

function vi(ch){ return VI[ch]===undefined?0:VI[ch]; }
function onsetKana(on,idx){
  if(on==='') return KT[''][idx];
  if(KT[on]) return KT[on][idx];
  var cs=splitC(on), out='';
  for(var i=0;i<cs.length-1;i++){
    var c=cs[i], fill=(c==='t'||c==='d')?4:2;
    out += KT[c] ? KT[c][fill] : (CODA[c]||'');
  }
  var last=cs[cs.length-1];
  out += KT[last] ? KT[last][idx] : KT[''][idx];
  return out;
}
function sylKana(sy){
  var p=parts(sy); if(!p) return '';
  var vs=p.nu.split('');
  var out=onsetKana(p.on, vi(vs[0]));
  for(var i=1;i<vs.length;i++) out+=VK[vi(vs[i])];
  if(p.co) splitC(p.co).forEach(function(c){ out += CODA[c]||''; });
  return out;
}
function kana(word){ return syl(word).map(sylKana).join(''); }

/* リンキング：語末の子音が次の語の母音に流れ込むのを、実際に再音節化して見せる */
function linked(words){
  var raw=words.map(function(w){return String(w).toLowerCase().replace(/[^a-z]/g,'');});
  var out='', any=false;
  for(var i=0;i<raw.length;i++){
    var cur=raw[i], nxt=raw[i+1];
    if(nxt && !isV(cur.charAt(cur.length-1)) && isV(nxt.charAt(0))){
      out += cur; any=true;              /* 空白を入れない＝ひと息でつながる */
    } else {
      out += cur; if(nxt) out+=' ';
    }
  }
  return {kana: out.split(' ').map(kana).join(' '), isLink:any};
}

function speak(text){
  try{
    if(!window.speechSynthesis){ toast('この端末では読み上げできません'); return; }
    speechSynthesis.cancel();
    var u=new SpeechSynthesisUtterance(text);
    u.lang='it-IT'; u.rate=.82;
    speechSynthesis.speak(u);
  }catch(e){ toast('読み上げできませんでした'); }
}

/* =========================================================================
   3. 生成 — 推定した規則に従って新しい語をつくる
   ========================================================================= */
function pick(o){
  var e=Object.keys(o).map(function(k){return [k,o[k]];});
  if(!e.length) return '';
  var t=0,i; for(i=0;i<e.length;i++) t+=e[i][1];
  var r=Math.random()*t;
  for(i=0;i<e.length;i++){ r-=e[i][1]; if(r<=0) return e[i][0]; }
  return e[0][0];
}
function taken(){
  var s={}; WORDS.forEach(function(w){ s[String(w.hw).toLowerCase()]=1; s['読:'+kana(w.hw)]=1; }); return s;
}
function makeWord(pos, A, tk){
  A=A||analyze(); tk=tk||taken();
  var rule=A.finalRule[pos];
  for(var t=0;t<120;t++){
    var n=Math.max(1,Math.min(3,+pick(A.cnt)||2));
    var w='';
    for(var i=0;i<n;i++){
      var pool = i===0 ? A.onI : (Object.keys(A.onM).length?A.onM:A.onI);
      w += pick(pool)+pick(A.nu);
    }
    if(rule){
      var ch=rule.ch;
      if(isV(ch)){ w=w.replace(/[^aeiouy]+$/,'').replace(/[aeiouy]+$/,ch); }
      else { w=w.replace(/[^aeiouy]+$/,'')+ch; }
    } else if(Object.keys(A.co).length && Math.random()<.35){
      w+=pick(A.co);
    }
    if(w.length<3) continue;
    if(tk[w]) continue;
    var rd='読:'+kana(w);          /* 読みがかぶる語も避ける（聞いて区別できないため） */
    if(tk[rd]) continue;
    tk[w]=1; tk[rd]=1;
    return w.charAt(0).toUpperCase()+w.slice(1);
  }
  return null;
}

/* リンキングが実際に起きる語の並びを、辞書の中から探してくる */
function linkPair(){
  if(WORDS.length<2) return null;
  var best=null, bs=-1;
  for(var i=0;i<WORDS.length;i++) for(var j=0;j<WORDS.length;j++){
    if(i===j) continue;
    var A=WORDS[i], B=WORDS[j];
    var a=String(A.hw).toLowerCase(), b=String(B.hw).toLowerCase();
    var link = !isV(a.charAt(a.length-1)) && isV(b.charAt(0));
    var nv = (A.pos==='名詞' && B.pos==='動詞');
    var s = (link?2:0)+(nv?1:0);
    if(s>bs){ bs=s; best={a:A,b:B,nv:nv}; }
    if(bs===3) return best;
  }
  return best;
}
function linkRun(){
  /* 音のページ用：つながりが起きる並びを優先して3語ならべる */
  var used={}, seq=[];
  var all=WORDS.slice();
  var start=null;
  for(var i=0;i<all.length;i++){
    var h=String(all[i].hw).toLowerCase();
    if(!isV(h.charAt(h.length-1))){ start=all[i]; break; }
  }
  seq.push(start||all[0]); used[seq[0].hw]=1;
  while(seq.length<3){
    var last=String(seq[seq.length-1].hw).toLowerCase();
    var want=!isV(last.charAt(last.length-1));
    var nxt=null;
    for(var k=0;k<all.length;k++){
      if(used[all[k].hw]) continue;
      var s=String(all[k].hw).toLowerCase();
      if(want && isV(s.charAt(0))){ nxt=all[k]; break; }
    }
    if(!nxt) for(var m=0;m<all.length;m++){ if(!used[all[m].hw]){nxt=all[m];break;} }
    if(!nxt) break;
    used[nxt.hw]=1; seq.push(nxt);
  }
  return seq;
}

/* =========================================================================
   4. 規則を日本語の文にする
   ========================================================================= */
function findings(){
  var A=analyze(), out=[];
  Object.keys(A.finalRule).forEach(function(p){
    var r=A.finalRule[p];
    out.push({t:p+'は <em>-'+r.ch+'</em> で終わる',
              d:r.all+'語中'+r.hit+'語がそうなっています。この形のまま新しい語をつくれます。',
              rate:r.rate});
  });
  if(A.sylMode && WORDS.length>=4){
    out.push({t:'ことばは <em>'+A.sylMode.n+'音節</em> が基本',
              d:A.sylMode.all+'語中'+A.sylMode.hit+'語。長さがそろうと、声に出したとき言語らしく響きます。',
              rate:A.sylMode.hit/A.sylMode.all});
  }
  var codas=Object.keys(A.co);
  if(codas.length && codas.length<=4 && WORDS.length>=4){
    out.push({t:'語の終わりに立つ子音は <em>'+codas.join(', ')+'</em> だけ',
              d:'ここが限られているほど、語をつなげたときの音が崩れません。',
              rate:1-codas.length/8});
  }
  if(A.unused.length>=4 && WORDS.length>=4){
    out.push({t:'<em>'+A.unused.slice(0,6).join(', ')+'</em> の音を使っていない',
              d:'使わない音が決まっていること自体が、その言語らしさになります。',
              rate:A.unused.length/CONS.length});
  }
  return out;
}

/* =========================================================================
   5. 画面
   ========================================================================= */
var route='home', cands=[], cat=0, sugPick='';
var app=document.getElementById('app');
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}

function toast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.add('on');
  clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('on');},1700);}

function go(r){ route=r; render(); window.scrollTo(0,0); }
function editName(){var v=prompt('言語の名前',langName); if(v&&v.trim()){langName=v.trim();save();render();}}

function head(){
  return '<div class="hd"><div class="logo">LINGUA</div>'+
   '<div class="lang" onclick="editName()">'+esc(langName)+' <span class="pen">✎</span></div></div>';
}

/* ---- ホーム ---- */
function vHome(){
  var F=findings(), A=analyze();
  var f = F.length
    ? F.map(function(x){return '<div class="find"><span class="tag">AIが見つけた</span>'+
        '<div class="ft">'+x.t+'</div><div class="fd">'+esc(x.d)+'</div>'+
        '<div class="bar"><i style="width:'+Math.round(Math.min(1,x.rate)*100)+'%"></i></div></div>';}).join('')
    : '<div class="empty">ことばが4つ集まると、AIがあなたの言語の規則を読み取りはじめます。</div>';

  var pair=linkPair();
  var sayHTML='';
  if(pair){
    var a=pair.a, b=pair.b, L=linked([a.hw,b.hw]);
    var gloss=pair.nv ? esc(a.mn)+'を、'+esc(b.mn)+'。' : esc(a.mn)+'の'+esc(b.mn)+'。';
    sayHTML='<div class="say">'+
      '<div class="w">'+esc(a.hw)+' '+esc(b.hw)+'</div>'+
      '<div class="k">'+kana(a.hw)+' '+kana(b.hw)+'</div>'+
      '<div class="jp">'+gloss+'</div>'+
      (L.isLink?'<div class="lk"><div class="lb">ひと息で言うと（リンキング）</div><div class="kk">'+L.kana+'</div></div>':'')+
      '<button class="sp" onclick="speak(\''+esc(a.hw+' '+b.hw)+'\')">▶ 声で聞く</button></div>';
  }

  return head()+
   '<div class="h1">あなたの言語は、いま<br>こういう規則で動いています。</div>'+
   '<div class="sub">つくった'+WORDS.length+'語をAIが読んで、見つけたことです。<br>言語の知識がなくても、続けるほど規則は勝手に育ちます。</div>'+
   '<div class="sec"><div class="sech"><b>見つかった規則</b><span class="c">'+F.length+'件</span></div>'+f+
     '<div class="btn2"><button class="btn red" onclick="go(\'make\')">この規則でことばを増やす</button></div></div>'+
   (sayHTML?'<div class="sec"><div class="sech"><b>きこえ方</b></div>'+sayHTML+'</div>':'')+
   '<div class="stats">'+
     '<div class="stat"><b>'+WORDS.length+'</b><span>ことば</span></div>'+
     '<div class="stat"><b>'+A.used.length+'</b><span>使う子音</span></div>'+
     '<div class="stat"><b>'+A.vowels.length+'</b><span>母音</span></div>'+
     '<div class="stat"><b>'+F.length+'</b><span>規則</span></div>'+
   '</div>';
}

/* ---- ことば ---- */
function lexHTML(items){
  var s=items.slice().sort(function(a,b){return String(a.hw).localeCompare(String(b.hw));});
  var html='', L='';
  s.forEach(function(w){
    var l=String(w.hw).charAt(0).toUpperCase();
    if(l!==L){L=l;html+='<div class="gl">'+L+'</div>';}
    html+='<div class="en" onclick="speak(\''+esc(w.hw)+'\')">'+
      '<span class="hw">'+esc(w.hw)+'</span><span class="kn">'+kana(w.hw)+'</span>'+
      '<span class="mn">'+esc(w.mn)+'</span><span class="ps">'+esc(w.pos)+'</span></div>';
  });
  return html||'<div class="empty" style="margin-top:20px">見つかりません</div>';
}
function vWords(){
  return head()+
   '<div class="h1">ことば <span style="font-size:.8rem;color:var(--faint);font-weight:400">'+WORDS.length+'</span></div>'+
   '<div class="sub">読みは、つづりから自動で決まります。タップで声が出ます。</div>'+
   '<div class="search">🔍<input placeholder="つづり・意味・読みでさがす" oninput="filter(this.value)"></div>'+
   '<div class="lex" id="lex">'+lexHTML(WORDS)+'</div>'+
   '<div class="bar-fix"><button class="btn" onclick="openAdd()">＋ ことばを1つ加える</button></div>';
}
function filter(q){
  q=q.trim().toLowerCase();
  var it=WORDS.filter(function(w){
    return !q || String(w.hw).toLowerCase().indexOf(q)>=0 || String(w.mn).indexOf(q)>=0 || kana(w.hw).indexOf(q)>=0;
  });
  document.getElementById('lex').innerHTML=lexHTML(it);
}

/* ---- 音 ---- */
function vSound(){
  var A=analyze();
  var cons=CONS.map(function(c){
    return A.used.indexOf(c)>=0
      ? '<span class="ph" onclick="speak(\''+c+'a\')">'+c+'</span>'
      : '<span class="ph off">'+c+'</span>';
  }).join('');
  var vow=A.vowels.map(function(v){return '<span class="ph" onclick="speak(\''+v+'\')">'+v+'</span>';}).join('');
  var nuc=Object.keys(A.nu).map(function(k){return [k,A.nu[k]];}).sort(function(a,b){return b[1]-a[1];})
    .map(function(x){return '<span class="ph" onclick="speak(\''+x[0]+'\')">'+x[0]+'<i>'+x[1]+'</i></span>';}).join('');
  var co=Object.keys(A.co).map(function(k){return [k,A.co[k]];}).sort(function(a,b){return b[1]-a[1];})
    .map(function(x){return '<span class="ph">-'+x[0]+'<i>'+x[1]+'</i></span>';}).join('') || '<span class="ph off">なし</span>';

  var many=linkRun().map(function(w){return w.hw;});
  var L=many.length>1?linked(many):null;

  return head()+
   '<div class="h1">音</div>'+
   '<div class="sub">つくった語から逆算した、この言語の音の在庫です。<br>薄い字は、まだ一度も使っていない音。</div>'+
   '<div class="sec"><div class="sech"><b>子音</b><span class="c">'+A.used.length+' / '+CONS.length+'</span></div><div class="inv">'+cons+'</div></div>'+
   '<div class="sec"><div class="sech"><b>母音</b></div><div class="inv">'+vow+'</div></div>'+
   '<div class="sec"><div class="sech"><b>母音のかたまり</b><span class="c">出てくる回数</span></div><div class="inv">'+nuc+'</div></div>'+
   '<div class="sec"><div class="sech"><b>語末に立つ子音</b></div><div class="inv">'+co+'</div>'+
     '<div style="font-size:.76rem;color:var(--sub);margin-top:8px">ここが少ないほど、語をつないだときの音が崩れません。</div></div>'+
   (L?'<div class="sec"><div class="sech"><b>つないで読む</b></div><div class="say">'+
      '<div class="w">'+esc(many.join(' '))+'</div>'+
      '<div class="k">'+many.map(kana).join(' ')+'</div>'+
      '<div class="lk"><div class="lb">'+(L.isLink?'子音が次の語に流れ込みます':'この並びでは音は流れ込みません')+'</div>'+
      '<div class="kk">'+L.kana+'</div></div>'+
      '<button class="sp" onclick="speak(\''+esc(many.join(' '))+'\')">▶ 声で聞く</button></div></div>':'')+
   '<div style="height:20px"></div>';
}

/* ---- つくる（量産） ---- */
var PACKS=[
  {n:'自然', list:[['水','名詞'],['火','名詞'],['土','名詞'],['風','名詞'],['空','名詞'],['星','名詞'],['月','名詞'],['太陽','名詞'],['山','名詞'],['川','名詞'],['海','名詞'],['森','名詞'],['木','名詞'],['石','名詞'],['雨','名詞'],['雪','名詞'],['雲','名詞'],['花','名詞'],['鳥','名詞'],['魚','名詞']]},
  {n:'からだ', list:[['手','名詞'],['足','名詞'],['目','名詞'],['耳','名詞'],['口','名詞'],['鼻','名詞'],['頭','名詞'],['髪','名詞'],['血','名詞'],['骨','名詞'],['肌','名詞'],['声','名詞'],['息','名詞'],['心臓','名詞']]},
  {n:'こころ', list:[['愛','名詞'],['恐れ','名詞'],['喜び','名詞'],['悲しみ','名詞'],['怒り','名詞'],['願い','名詞'],['夢','名詞'],['記憶','名詞'],['思う','動詞'],['忘れる','動詞'],['信じる','動詞'],['祈る','動詞']]},
  {n:'暮らし', list:[['人','名詞'],['子','名詞'],['母','名詞'],['父','名詞'],['友','名詞'],['名','名詞'],['家','名詞'],['道','名詞'],['村','名詞'],['旅','名詞'],['歌','名詞'],['王','名詞'],['神','名詞'],['行く','動詞'],['来る','動詞'],['見る','動詞'],['話す','動詞'],['眠る','動詞']]}
];
function buildCands(){
  var have={}; WORDS.forEach(function(w){have[w.mn]=1;});
  var A=analyze(), tk=taken();
  cands=[];
  PACKS[cat].list.forEach(function(x){
    if(have[x[0]]) return;
    var hw=makeWord(x[1],A,tk);
    if(hw) cands.push({hw:hw,mn:x[0],pos:x[1],on:true});
  });
}
function vMake(){
  if(!cands.length) buildCands();
  var A=analyze(), R=A.finalRule, keys=Object.keys(R);
  var ruleLine = keys.length
    ? keys.map(function(p){return p+'は -'+R[p].ch;}).join('、')+' という規則を守って生成しています'
    : 'まだ規則が見えていないので、いまある音の組み合わせだけで生成しています';
  var chips=PACKS.map(function(p,i){return '<span class="chip'+(i===cat?' on':'')+'" onclick="setCat('+i+')">'+p.n+'</span>';}).join('');
  var rows=cands.map(function(c,i){return '<div class="cand'+(c.on?' on':'')+'">'+
      '<span class="ck" onclick="tog('+i+')">'+(c.on?'✓':'')+'</span>'+
      '<span class="cw" onclick="speak(\''+esc(c.hw)+'\')">'+esc(c.hw)+'</span>'+
      '<span class="cn">'+kana(c.hw)+'</span>'+
      '<span class="cm">'+esc(c.mn)+'</span>'+
      '<span class="re" onclick="reroll('+i+')">引き直す</span></div>';}).join('');
  var n=cands.filter(function(c){return c.on;}).length;
  return head()+
   '<div class="h1">まとめてつくる</div>'+
   '<div class="sub">'+esc(ruleLine)+'。<br>いらないものだけ外して、まとめて辞書に入れられます。</div>'+
   '<div class="sec" style="padding-bottom:2px"><div class="chips">'+chips+'</div></div>'+
   '<div class="sec" style="padding-top:12px">'+rows+'</div>'+
   '<div class="bar-fix"><div class="btn2" style="margin:0">'+
     '<button class="btn ghost" onclick="regen()">ぜんぶ引き直す</button>'+
     '<button class="btn red" onclick="commit()">'+n+'語を辞書に入れる</button></div></div>';
}
function setCat(i){cat=i;cands=[];render();}
function tog(i){cands[i].on=!cands[i].on;render();}
function reroll(i){
  var tk=taken(); cands.forEach(function(c){tk[String(c.hw).toLowerCase()]=1;});
  var hw=makeWord(cands[i].pos,analyze(),tk);
  if(hw){cands[i].hw=hw;render();}
}
function regen(){cands=[];render();}
function commit(){
  var add=cands.filter(function(c){return c.on;}).map(function(c){return {hw:c.hw,mn:c.mn,pos:c.pos};});
  if(!add.length){toast('選ばれている語がありません');return;}
  WORDS=add.concat(WORDS); save(); cands=[];
  toast(add.length+'語を辞書に入れました');
  go('home');
}

/* ---- 1語ずつ加えるシート ---- */
function openAdd(){
  sugPick='';
  document.getElementById('sheet').innerHTML=
   '<div class="grip"></div><h3>ことばを1つ加える</h3>'+
   '<div class="lead">意味だけ入れれば、あなたの言語の規則に合う候補が出ます。</div>'+
   '<div class="row2"><div class="fld"><label>意味（日本語）</label><input id="f-mn" placeholder="海"></div>'+
   '<div class="fld"><label>品詞</label><select id="f-pos" onchange="sugs()">'+
     '<option>名詞</option><option>動詞</option><option>形容詞</option><option>副詞</option></select></div></div>'+
   '<div class="sug" id="sug"></div>'+
   '<div class="fld"><label>つづり</label><input class="lt" id="f-hw" placeholder="Aelin" oninput="pv()" autocomplete="off"></div>'+
   '<div class="pv"><div class="pl">読み（つづりから自動）</div><div class="pk" id="f-pv">—</div></div>'+
   '<button class="btn" onclick="addOne()">辞書に加える</button>';
  document.getElementById('sbg').classList.add('on');
  document.getElementById('sheet').classList.add('on');
  sugs();
}
function closeS(){document.getElementById('sbg').classList.remove('on');document.getElementById('sheet').classList.remove('on');}
var sugList=[];
function sugs(){
  var pos=document.getElementById('f-pos').value;
  var tk=taken(), A=analyze();
  sugList=[];
  for(var i=0;i<3;i++){ var w=makeWord(pos,A,tk); if(w) sugList.push(w); }
  sugPick='';
  paintSug();
}
function paintSug(){
  document.getElementById('sug').innerHTML=sugList.map(function(w){
    return '<span class="s'+(w===sugPick?' on':'')+'" onclick="useSug(\''+w+'\')">'+w+
      '<i style="font-style:normal;font-size:.62rem;color:'+(w===sugPick?'rgba(255,255,255,.8)':'var(--faint)')+';margin-left:5px">'+kana(w)+'</i></span>';
  }).join('')+'<span class="s" onclick="sugs()">↻ 別の案</span>';
}
function useSug(w){sugPick=w;document.getElementById('f-hw').value=w;pv();paintSug();}
function pv(){
  var v=document.getElementById('f-hw').value.trim();
  document.getElementById('f-pv').textContent=v?kana(v):'—';
}
function addOne(){
  var hw=document.getElementById('f-hw').value.trim();
  var mn=document.getElementById('f-mn').value.trim();
  if(!hw||!mn){toast('意味とつづりを入れてください');return;}
  WORDS.unshift({hw:hw.charAt(0).toUpperCase()+hw.slice(1),mn:mn,pos:document.getElementById('f-pos').value});
  save(); closeS(); toast('加えました'); render();
}

/* ---- tabs / render ---- */
var TABS=[['home','I','ホーム'],['words','II','ことば'],['sound','III','音'],['make','IV','つくる']];
function render(){
  app.innerHTML='<div class="fade">'+
    (route==='home'?vHome():route==='words'?vWords():route==='sound'?vSound():vMake())+'</div>';
  document.getElementById('tabs').innerHTML=TABS.map(function(t){
    return '<div class="tab'+(route===t[0]?' on':'')+'" onclick="go(\''+t[0]+'\')"><b>'+t[1]+'</b>'+t[2]+'</div>';
  }).join('');
}
render();
</script>
</body>
</html>
