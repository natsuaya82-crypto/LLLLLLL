<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Lingua</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Google's sign-in comes back to the app through a URL scheme, and the
	     scheme is the client id with its two halves swapped: a client id of
	     123-abc.apps.googleusercontent.com is the scheme
	     com.googleusercontent.apps.123-abc. Google's SDK reads it from here
	     and refuses to start if it is missing or does not match.

	     There is no CFBundleURLTypes here, and that is deliberate. A
	     placeholder stood in this file for one build and Apple refused the
	     delivery: build 86 came back as ITMS-90158, "URL schemes need to
	     begin with an alphabetic character". A scheme of underscores is not
	     merely unset, it is malformed, and nothing on this side says so.
	     An absent key is the honest shape of "not configured".

	     When the client is made in the Google Cloud console, this block goes
	     back with the real value:

	       <key>CFBundleURLTypes</key>
	       <array>
	         <dict>
	           <key>CFBundleURLSchemes</key>
	           <array>
	             <string>com.googleusercontent.apps.123-abc</string>
	           </array>
	         </dict>
	       </array>

	     and GOOGLE_IOS_ID in www/net.js takes the client id at the same
	     time. Both, or neither: one without the other is a button that opens
	     a sheet and cannot come back. Neither of them is a secret. Until
	     then the Google button says it is not in this build, which is true,
	     and Apple's sign-in is unaffected. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- A language is written to Documents as a file, and these two are the
	     whole of what makes it a thing the person owns: the Files app can
	     show the folder, and a file in it can be opened where it lies rather
	     than copied somewhere first. Without them the copy still exists and
	     is still in the device backup, but nobody can reach it. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- A post can carry thirty seconds of the person's own voice, which is
	     the only way anybody hears what a made-up language sounds like.
	     Without this line iOS does not refuse the microphone: it kills the
	     app the moment it is asked for, with nothing on screen and nothing
	     in the log about a microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>To record your own voice on a post, so other people can hear how your language sounds.</string>
	<!-- The camera button on the composer. Same trap as the microphone and it
	     was walked straight into: without this line iOS does not refuse the
	     camera, it kills the app the instant one is asked for. The button
	     shipped in build 56 and crashed on the first press. -->
	<key>NSCameraUsageDescription</key>
	<string>To take a photograph for a post.</string>
	<!-- And the library, which is a picker of the person's own photographs. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To put one of your photographs on a post.</string>
</dict>
</plist>
