<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Lingua</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!--- Google's sign-in comes back to the app through a URL scheme, and the
	     scheme is the client id with its two halves swapped. Google's SDK reads
	     it from here and refuses to start if it is missing or does not match.

	     This value and GOOGLE_IOS_ID in www/net.js are the same client id and
	     have to stay that way: one without the other is a button that opens a
	     sheet and cannot come back. Neither is a secret — the id names the app
	     and proves nothing.

	     A PLACEHOLDER once stood here and Apple refused the delivery: build 86
	     came back as ITMS-90158, "URL schemes need to begin with an alphabetic
	     character". A scheme of underscores is not merely unset, it is
	     malformed. If this client ever goes away, DELETE this whole block:
	     an absent key is the honest shape of "not configured". Do not leave a
	     stand-in. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.535150348007-i8roam4vdjjlfql5ktb4mld3v9chb6gr</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- A language is written to Documents as a file, and these two are the
	     whole of what makes it a thing the person owns: the Files app can
	     show the folder, and a file in it can be opened where it lies rather
	     than copied somewhere first. Without them the copy still exists and
	     is still in the device backup, but nobody can reach it. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- A post can carry thirty seconds of the person's own voice, which is
	     the only way anybody hears what a made-up language sounds like.
	     Without this line iOS does not refuse the microphone: it kills the
	     app the moment it is asked for, with nothing on screen and nothing
	     in the log about a microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>To record your own voice on a post, so other people can hear how your language sounds.</string>
	<!-- The camera button on the composer. Same trap as the microphone and it
	     was walked straight into: without this line iOS does not refuse the
	     camera, it kills the app the instant one is asked for. The button
	     shipped in build 56 and crashed on the first press. -->
	<key>NSCameraUsageDescription</key>
	<string>To take a photograph for a post.</string>
	<!-- And the library, which is a picker of the person's own photographs. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To put one of your photographs on a post.</string>
	<!-- AdMob, for the places in the timeline nobody has bought
	     (App/LinguaAds.swift). Both ids are filled by
	     .github/workflows/ios-deploy.yml from GitHub secrets, and with Google's
	     own TEST ids until the owner has made Lingua's in AdMob; a build never
	     ships these names as they are (build 86, ITMS-90158). -->
	<key>GADApplicationIdentifier</key>
	<string>__ADMOB_APP_ID__</string>
	<key>LinguaAdUnit</key>
	<string>__ADMOB_NATIVE_UNIT__</string>
	<!-- The question iOS asks before an ad may be chosen by tracking. Asked
	     only while nobody has answered it, the way jpel does; saying no still
	     shows ads, only not ones chosen for you. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Lingua asks so the ads between posts can be ones that matter to you. The app works the same if you say no.</string>
	<!-- The ad networks allowed to count an install without tracking. Google's
	     list, as jpel carries it. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict><key>SKAdNetworkIdentifier</key><string>cstr6suwn9.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>4fzdc2evr5.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>2fnua5tdw4.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>ydx93a7ass.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>p78axxw29g.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>v72qych5uu.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>ludvb6z3bs.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>cp8zw746q7.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>c6k4g5qg8m.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>s39g8k73mm.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>3qy4746246.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>f38h382jlk.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>hs6bdukanm.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>v4nxqhlyqp.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>wzmmz9fp6w.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>yclnxrl5pm.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>4468km3ulz.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>2u9pt9hc89.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>klf5c3l5u5.skadnetwork</string></dict>
		<dict><key>SKAdNetworkIdentifier</key><string>ppxm28t8ap.skadnetwork</string></dict>
	</array>
</dict>
</plist>
