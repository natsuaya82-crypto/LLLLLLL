default_platform(:ios)

platform :ios do
  desc "TestFlight（App Store Connect）へビルド&アップロード"
  lane :beta do
    # --- App Store Connect API キーで認証（Mac不要のクラウド署名に使う） ---
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],      # .p8 を base64 化した文字列
      is_key_content_base64: true,
      in_house: false
    )

    team  = ENV["APPLE_TEAM_ID"]
    build = ENV["BUILD_NUMBER"] || "1"     # CIのrun番号を渡す（ビルド番号は毎回ユニークに）

    # --- アーカイブ&エクスポート（自動署名 + クラウド管理の配布証明書） ---
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Lingua.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{team} CURRENT_PROJECT_VERSION=#{build}",
      export_options: {
        signingStyle: "automatic",
        teamID: team
      }
    )

    # --- TestFlight へアップロード ---
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
